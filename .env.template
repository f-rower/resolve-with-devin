# GitHub PAT used by this app to read issues/labels and post comments.
# Fine-grained token scoped to the target repo, "Issues: Read and write" permission only.
# This is unrelated to Devin's own GitHub App connection below.
GITHUB_TOKEN=your_github_token_here

# owner/repo of the target repository (e.g. the Superset fork), not this repo.
GITHUB_REPOSITORY=your_github_username/your_target_repo

# Devin v3 service-user credentials, created at app.devin.ai -> Settings -> Service Users.
# DEVIN_API_TOKEN has a cog_... prefix. DEVIN_ORG_ID is shown on the same page.
# Devin can only open PRs on GITHUB_REPOSITORY if that same repo is also connected via
# app.devin.ai -> Settings -> Integrations -> GitHub -> Add Connection.
DEVIN_API_TOKEN=your_devin_api_token_here
DEVIN_ORG_ID=your_devin_org_id_here

# Keep low while iterating. Each Devin session consumes ACUs.
MAX_ACU_LIMIT=5

# How often the two background loops poll, in seconds.
POLL_INTERVAL_SECONDS=45
SESSION_POLL_INTERVAL_SECONDS=20

DATABASE_PATH=./data/jobs.db